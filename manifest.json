{
  "manifest_version": 2,
  "name": "Watch on Keepa",
  "author": "NeKuNeKo",
  "version": "1.0.1",
  "description": "Unofficial shortcut to check Amazon product price history charts on Keepa via right-click or toolbar button.",
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": ["contextMenus", "tabs"],
  "browser_action": {
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg",
      "48": "icon.svg"
    },
    "default_title": "Watch on Keepa"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{8f4b2c91-3e7a-4d19-9b52-6a1e0c4d7823}",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "113.0"
    }
  }
}
